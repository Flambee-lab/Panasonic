{
  "name": "panasonic-ui-flows",
  "version": "1.0.0",
  "private": true,
  "description": "Panasonic design handoff: alarm rules, exceptions and camera selection variants",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "alarm-rules-main-flow",
    "exceptions",
    "camera-selection-variants"
  ],
  "scripts": {
    "dev": "npm run dev:alarm-rules",
    "dev:alarm-rules": "npm run dev --workspace=@panasonic/alarm-rules-main-flow -- --port 5173 --strictPort --open /alarm-rules",
    "dev:exceptions": "npm run dev --workspace=@panasonic/exceptions -- --port 5174 --strictPort --open /alarm-rules?section=exceptions",
    "dev:cameras": "npm run dev:cameras:v1",
    "dev:cameras:v1": "npm run dev --workspace=@panasonic/camera-selection-variants -- --port 5175 --strictPort --open /?variant=1",
    "dev:cameras:v2": "npm run dev --workspace=@panasonic/camera-selection-variants -- --port 5175 --strictPort --open /?variant=2",
    "dev:cameras:v3": "npm run dev --workspace=@panasonic/camera-selection-variants -- --port 5175 --strictPort --open /?variant=3",
    "build": "npm run build --workspaces",
    "test": "node --test scripts/handoff-contract.test.mjs && npm test --workspace=@panasonic/camera-selection-variants"
  }
}
